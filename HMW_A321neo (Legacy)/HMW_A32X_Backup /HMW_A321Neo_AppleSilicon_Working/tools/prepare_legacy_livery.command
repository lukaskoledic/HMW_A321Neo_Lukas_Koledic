#!/bin/zsh
set -euo pipefail

script_dir=$(cd "$(dirname "$0")" && pwd)
package_dir=$(cd "$script_dir/.." && pwd)

if [[ $# -ne 1 ]]; then
    print -u2 "Usage: zsh tools/prepare_legacy_livery.command \"Livery Name\""
    exit 2
fi

livery_name="$1"
if [[ -z "$livery_name" || "$livery_name" == .* || "$livery_name" == */* ]]; then
    print -u2 "Use a non-empty livery name without a leading dot or slash."
    exit 2
fi

livery_dir="$package_dir/liveries/$livery_name"
if [[ -e "$livery_dir" ]]; then
    print -u2 "Refusing to overwrite an existing livery: $livery_dir"
    exit 2
fi

mkdir -p "$livery_dir/objects/legacy/texture"

for rel in \
    texture/fuselage_fuselage_ALB.png \
    texture/fuselage_h_stabs_ALB.png \
    texture/fuselage_wing_ALB.png \
    texture/fuselage_wingbox_ALB.png \
    texture/front_gears_baked.png \
    texture/fuselage_inside_doors_ALB.png \
    texture/fuselage_cargo_bay_ALB.png \
    texture/fuselage_cargo_bay_LIT.png; do
    cp "$package_dir/objects/legacy/$rel" "$livery_dir/objects/legacy/$rel"
done

cat > "$livery_dir/README.txt" <<'EOF'
Legacy livery starter generated by prepare_legacy_livery.command.

Paint the copied 4096x4096 PNGs in objects/legacy/texture/.
Keep the filenames, dimensions, power-of-two size, and UV layout unchanged.
The aircraft keeps its supplied normal maps unless you add matching legacy
_NRM files in this same folder. The blue cockpit textures are intentionally
not part of this starter.
EOF

print "Created legacy livery starter:"
print "  $livery_dir"
print "Paint the copied PNG files under objects/legacy/texture."
